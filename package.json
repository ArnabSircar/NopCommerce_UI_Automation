{
  "name": "nopcommerce_ui_automation",
  "version": "1.0.0",
  "description": "Full fledged UI automation testing for nopCommerce demo site using Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:allure": "playwright test --reporter=line,allure-playwright",
    "allure:generate": "allure generate ./allure-results -o ./allure-report --clean",
    "allure:open": "allure open ./allure-report",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:functional": "playwright test --grep @functional",
    "lint": "eslint tests/ pages/ components/ utils/"
  },
  "keywords": ["playwright", "nopcommerce", "automation", "testing", "e2e"],
  "author": "QA Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure-playwright": "^3.2.0",
    "allure-commandline": "^2.29.0",
    "dotenv": "^16.4.5"
  }
}